    "@electron/asar": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^44.5.1",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3"
  },
