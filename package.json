{
  "name": "obi-quest-v1",
  "private": true,
  "version": "1.4.2",
  "description": "Plataforma de treino para as modalidades da Olimpíada Brasileira de Informática",
  "author": "OBI Quest",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && .\\gradlew.bat assembleDebug",
    "app:windows": "npm run build && electron .",
    "app:windows:package": "npm run build && node scripts/package-windows.cjs",
    "app:windows:installer": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^0.525.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.3",
    "@capacitor/cli": "^8.4.3",
    "@capacitor/core": "^8.4.3",
    "@electron/asar": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "build": {
    "appId": "com.obique.quest",
    "productName": "OBI Quest",
    "electronLanguages": [
      "en-US",
      "pt-BR"
    ],
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "OBI-Quest-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false
    }
  }
}
